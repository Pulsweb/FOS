/// Cost_Analysis Version Table
table audit_latest_available_cost_analysis_version
	lineageTag: 73ef1116-064e-4550-8c98-f45b50ca8628
	sourceLineageTag: [cost].[audit_latest_available_cost_analysis_version]

	/// Indicates whether an Cost_Analysis update is available by comparing the current Cost_Analysis version with the latest available version.
	measure 'Cost_Analysis Update Available' = ```

						IF([Cost_Analysis Release] == MAX(audit_latest_available_cost_analysis_version[current_cost_analysis_version]), 0, 1)
			```
		formatString: 0
		lineageTag: 8f8ddc82-e24d-493e-a6b3-203142979dfa

		changedProperty = Name

		changedProperty = Description

	/// A static string value for Cost_Analysis Release.
	measure 'Cost_Analysis Release' = "2026.10.29"
		lineageTag: ba9a1bef-cb0e-42f4-8d14-ad6467ada7b7

		changedProperty = Name

		changedProperty = Description

	/// Displays a string message based on whether the Cost_Analysis Release is equal to the maximum current Cost_Analysis version.
	measure 'Cost_Analysis Release Message' = ```

						IF(
						    [Cost_Analysis Release]== MAX(audit_latest_available_cost_analysis_version[current_cost_analysis_version]),
						     "Cost_Analysis is up-to-date",
						     "Update is available"
						    )
			```
		lineageTag: 0fc23fce-bf93-42a8-bb4c-84a204691719

		changedProperty = Name

		changedProperty = Description

	/// Build Version
	column build_version
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: e1007905-a339-4e7a-9423-5e6373ce0f78
		sourceLineageTag: build_version
		summarizeBy: sum
		sourceColumn: build_version

		changedProperty = Description

